{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lease Severity Assessment Output",
  "type": "object",
  "required": ["severities"],
  "properties": {
    "severities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provision_id", "severity", "severity_reasoning", "financial_impact", "recommended_action"],
        "properties": {
          "provision_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "severity_reasoning": {"type": "string"},
          "financial_impact": {"type": "string"},
          "recommended_action": {"type": "string"}
        }
      }
    }
  }
}