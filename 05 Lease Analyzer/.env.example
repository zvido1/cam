# ═══════════════════════════════════════════════════════════════
# CAM Lease Analyzer — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── Access Control ──
# Access code required to use the web app (shared with authorized users)
ACCESS_CODE=cam_demo_2026

# ── Email / SMTP (Optional) ──
# If configured, users receive an email when their analysis is complete.
# If not configured, the app works fine — users just bookmark their results link.
#
# For Gmail: use an App Password (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
NOTIFICATION_FROM=CAM Lease Analyzer <your.email@gmail.com>

# ── App Settings ──
# Base URL used in email links and results URLs
APP_BASE_URL=http://localhost:8000

# Results expiration (minutes after first view). Countdown starts when user
# first opens the results link. Unopened results have a 24-hour backstop.
JOB_EXPIRY_MINUTES=30

# ── Directories ──
# Where uploaded files and results are stored (defaults to subdirectories of the app)
# UPLOAD_DIR=
# RESULTS_DIR=

# ── AI Provider API Keys ──
# These are read by the CAM pipeline, not the web app directly.
# At least the providers used by the lease adapter must be configured.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GOOGLE_API_KEY=AIza...
